---
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonicalPath?: string;
};

const {
  title = "Mahdi Sepaseh — Senior Frontend Engineer",
  description = "Senior frontend engineer focused on frontend architecture, system design, technical leadership, and product engineering.",
  canonicalPath = Astro.url.pathname
} = Astro.props;

const pageTitle = title.includes("Mahdi Sepaseh")
  ? title
  : `${title} — Mahdi Sepaseh`;
const canonicalUrl = new URL(canonicalPath, Astro.site);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/about", label: "About" },
  { href: "/resume", label: "Resume" },
  { href: "/experience", label: "Experience" },
  { href: "/projects", label: "Projects" }
];

const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1e9" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Mahdi Sepaseh, home">
          <span class="wordmark-mark" aria-hidden="true">MS</span>
          <span>Mahdi Sepaseh</span>
        </a>

        <nav aria-label="Primary navigation">
          <ul class="nav-list">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="footer-name">Mahdi Sepaseh</p>
          <p>Senior Frontend Engineer</p>
        </div>
        <div class="footer-links">
          <a href="mailto:m.sepaseh@gmail.com">Email</a>
          <a href="https://www.linkedin.com/in/sepaseh/" rel="me">LinkedIn</a>
          <a href="https://github.com/sepaseh" rel="me">GitHub</a>
        </div>
        <p class="footer-note">
          Content sourced from the
          <a href="https://github.com/sepaseh/career">career repository</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
