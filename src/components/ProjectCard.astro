---
const fa = Astro.url.pathname.startsWith("/fa");
const prefix = fa ? "/fa" : "";
import type { CareerEntry } from "@/lib/career";

type Props = {
  project: CareerEntry;
  index: number;
};

const { project, index } = Astro.props;
---

<article class="project-card">
  <div class="card-index">{String(index + 1).padStart(2, "0")}</div>
  <div>
    <h3><a href={`${prefix}/projects/${project.slug}`}>{project.title}</a></h3>
    <p>{project.description}</p>
  </div>
  <a
    class="card-arrow"
    href={`${prefix}/projects/${project.slug}`}
    aria-label={fa ? `مطالعه ${project.title}` : `Read ${project.title}`}
  >
    <span aria-hidden="true">↗</span>
  </a>
</article>
