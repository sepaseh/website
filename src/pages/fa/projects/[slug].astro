---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleLayout from "@/components/ArticleLayout.astro";
import { getProjects } from "@/lib/career";

export function getStaticPaths() {
  return getProjects("fa").map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} — پروژه`}
  description={project.description}
>
  <ArticleLayout
    eyebrow="پروژه"
    title={project.title}
    description={project.description}
    backHref="/fa/projects"
    backLabel="همه پروژه‌ها"
    html={project.html}
  />
</BaseLayout>
