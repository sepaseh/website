---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ArticleLayout from "@/components/ArticleLayout.astro";
import { getDocument } from "@/lib/career";

const resume = getDocument("resume");
---

<BaseLayout
  title="Resume"
  description="Resume of Mahdi Sepaseh, senior frontend engineer specializing in React, TypeScript, and frontend architecture."
>
  <div class="shell resume-download"><a class="button button-primary" href="/downloads/mahdi-sepaseh-resume-ats-en.pdf" download>Download resume PDF</a></div>
  <ArticleLayout
    eyebrow="Resume"
    title="A concise professional overview."
    description="Senior Frontend Engineer specializing in React, TypeScript, and frontend architecture."
    backHref="/"
    backLabel="Home"
    html={resume.html}
  />
</BaseLayout>
